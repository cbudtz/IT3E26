# Postgres-forbindelse (Drizzle). I CapRover: peg paa din Postgres-app.
DATABASE_URL=postgresql://bruger:kodeord@host:5432/database

# DTU-brugernavne (CAS-login) der maa hoste quizzer (/quiz/host). Kommasepareret.
# Seedes i databasen ved hver opstart.
SUPERUSERS=chbu,kollega

# Kun ved lokal test af prod-build (npm start): fortael SvelteKit sin egen URL til CAS-callback.
# I CapRover er det unoedvendigt (PROTOCOL_HEADER/HOST_HEADER saettes i Dockerfile).
# ORIGIN=http://localhost:3000

# Postgres-forbindelse (Drizzle). I CapRover: peg paa din Postgres-app.
DATABASE_URL=postgresql://bruger:kodeord@host:5432/database

# Undervisere med adgang til quiz-host (/quiz/host). Format: brugernavn:kodeord, kommasepareret.
# Seedes/opdateres i databasen ved hver opstart - skift kodeord her og genstart.
SUPERUSERS=chbu:skift-mig,kollega:ogsaa-skift-mig
